# Application
APP_PROJECT_NAME=clinic-mock
APP_VERSION=1.0.0
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_JSON_LOGS=false

# Langfuse (per APIs.md §14.1)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENVIRONMENT=sandbox
LANGFUSE_TRACES_ENABLED=true

# Mock auth: each key is a separate tenant. Three recommended keys for dev /
# test / prod. Comma-separated `tenant_id:sk_...` pairs. Each key grants full
# access to its own tenant scope. Keys missing the `sk_` prefix are dropped.
MOCK_API_KEYS=dev:sk_dev_replace_me,test:sk_test_replace_me,prod:sk_prod_replace_me

# Team demo only; leave disabled on the mentor scoring instance.
MOCK_BOOKING_FIXTURES=0
# Empty: first fixture day is tomorrow (+07:00), resolved at startup/seed/reset.
# Tests can pin YYYY-MM-DD. Dates must still be in the future for bot calls.
MOCK_BOOKING_BASE_DATE=

# Exclusive recording profile; only on the team's own video-demo instance.
# Disable MOCK_WEEK2_FIXTURES and MOCK_BOOKING_FIXTURES before enabling this.
MOCK_RECORDING_FIXTURES=0
# Pin the demo date, or leave empty to use tomorrow in Vietnam on seed/reset.
MOCK_RECORDING_BASE_DATE=
